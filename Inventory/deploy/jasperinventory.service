[Unit]
Description=JasperInventory web app
After=network-online.target
Wants=network-online.target

[Service]
User=jasper
Group=jasper
WorkingDirectory=/opt/jasperpower/Inventory
EnvironmentFile=/etc/jasperinventory.env
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
